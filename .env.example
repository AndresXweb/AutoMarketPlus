# ── Correo (verificación + recuperar contraseña) ───────────────────────────
# Mismo Gmail + contraseña de aplicación del proyecto anterior está bien.
MAIL_USERNAME=tu-correo@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM_NAME=AutoMarket

# ── Google Sign-In (idToken) ────────────────────────────────────────────────
# Consola Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth
# Tipo: Aplicación web
# Orígenes JS autorizados: http://localhost:8080  y tu dominio de producción
# URI de redirección: http://localhost:8080/api/auth/callback/google
#                     https://tu-dominio.com/api/auth/callback/google
VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ── Auth general ────────────────────────────────────────────────────────────
# No pongas "false" si quieres login real
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_SECRET=genera-un-string-largo-aleatorio
# BETTER_AUTH_URL=http://localhost:8080
